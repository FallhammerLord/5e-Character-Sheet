{{!-- The item sheet's Description tab (SCOPE §4.13, user 2026-10-28), Tidy Classic's way: a column of properties
      (quantity, weight, price, uses, a spell's casting lines, the category) beside the description. Fields in edit
      mode; the description is a prose-mirror that shows its text until the player chooses to edit (quest log rule). --}}
<section class="tab fhcs-item-description {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
   {{#with fhcsItem}}
   {{#if info.length}}
   {{!-- dnd5e's info row (a species' type, movement and senses; a weapon's to-hit and damage): its values are dnd5e's
         HTML; a gear opens dnd5e's settings window for it. --}}
   <dl class="fhcs-frame fhcs-item-info">
      {{#each info}}
      <div class="fhcs-item-info-cell">
         <dt class="fhcs-label fhcs-muted">{{ label }}{{#if canConfigure}}<button type="button" class="fhcs-toggle fhcs-gear-button" data-action="showConfiguration"
                 data-config="{{ config }}" aria-label="{{ tip }}" data-fhcs-tip="{{ tip }}">{{> "modules/fhcs/templates/sheet/gear.hbs" }}</button>{{/if}}</dt>
         <dd class="fhcs-body">{{{ value }}}</dd>
      </div>
      {{/each}}
   </dl>
   {{/if}}
   <div class="fhcs-item-body{{#if wide}} fhcs-item-wide{{/if}}">
      {{#if hasProps}}
      <div class="fhcs-frame fhcs-item-props" role="group" aria-label="{{ text.properties }}">
         <dl class="fhcs-item-prop-list">
            {{#each props}}
            <div class="fhcs-item-prop">
               <dt class="fhcs-label fhcs-muted">{{ label }}</dt>
               <dd class="fhcs-body">
                  {{#if ../fields}}{{#if field}}
                  <input type="text" class="fhcs-input fhcs-body" name="{{ field }}" value="{{ value }}" placeholder="{{ placeholder }}"
                         aria-label="{{ label }}"{{#if number}} data-dtype="Number" inputmode="decimal"{{/if}}>{{#if unitInput}}{{{ unitInput }}}{{else if unit}}<span class="fhcs-muted">{{ unit }}</span>{{/if}}
                  {{else if input}}{{{ input }}}{{else}}{{ value }}{{/if}}{{else}}{{ value }}{{ unitText }}{{/if}}
               </dd>
            </div>
            {{/each}}
         </dl>
         {{#if tags.length}}
         <ul class="fhcs-item-tags">
            {{#each tags}}<li class="fhcs-body">{{ this }}</li>{{/each}}
         </ul>
         {{/if}}
      </div>
      {{/if}}
      <div class="fhcs-item-texts">
         {{#each descriptions}}
         <div class="fhcs-frame fhcs-item-text" data-fhcs-description="{{ key }}">
            <div class="fhcs-panel-head"><span class="fhcs-label">{{ label }}</span></div>
            {{#if ../fields}}
            <prose-mirror name="{{ name }}" value="{{ source }}" document-uuid="{{ ../uuid }}" toggled>{{{ enriched }}}{{#if empty}}<p class="fhcs-body fhcs-muted">{{ ../text.empty }}</p>{{/if}}</prose-mirror>
            {{else}}
            {{#if empty}}<p class="fhcs-body fhcs-muted">{{ ../text.empty }}</p>{{else}}<div class="fhcs-body fhcs-item-prose">{{{ enriched }}}</div>{{/if}}
            {{/if}}
         </div>
         {{/each}}
      </div>
   </div>
   {{/with}}
</section>
