<div class="fhcs-card">
   {{> "modules/fhcs/templates/chat/parts/header.hbs" fhcs }}

   {{#if fhcs.hasDetails}}
   <details class="fhcs-card-details" data-fold-key="description">
      <summary>{{ localize "FHCS.Card.Description" }}</summary>
      {{#if fhcs.flavor}}<div class="fhcs-card-flavor">{{{ fhcs.flavor }}}</div>{{/if}}
      {{#if fhcs.description}}<div class="fhcs-card-description">{{{ fhcs.description }}}</div>{{/if}}
      {{#each fhcs.supplements}}<p class="fhcs-card-supplement"><span class="fhcs-band-heading">{{ label }}</span> {{ detail }}</p>{{/each}}
      {{#if fhcs.tags.length}}
      <ul class="fhcs-card-tags">{{#each fhcs.tags}}<li>{{ this }}</li>{{/each}}</ul>
      {{/if}}
   </details>
   {{/if}}

   {{#each fhcs.bands}}
   {{#if isSave}}
   <div class="fhcs-band fhcs-band-{{ kind }} fhcs-band-group">
      <button type="button" class="fhcs-band-button" data-action="{{ action }}" data-index="{{ index }}">
         <span class="fhcs-band-top"><span class="fhcs-band-heading">{{ heading }}</span><span class="fhcs-band-end"></span></span>
         <span class="fhcs-band-text">{{ text }}</span>
         <span class="fhcs-band-prompt">{{ prompt }}</span>
      </button>
      {{#if rows.length}}
      <ul class="fhcs-rows">
         {{#each rows}}
         <li class="fhcs-row" data-message-id="{{ id }}">
            <details class="fhcs-row-details" data-fold-key="row-{{ id }}"{{#if open}} open{{/if}}>
               <summary class="fhcs-row-summary">
                  <span class="fhcs-row-who">{{ who }}</span>
                  <strong class="fhcs-row-total">{{ total }}</strong>
                  <span class="fhcs-row-verdict{{#if verdict}} fhcs-verdict-{{ verdict }}{{/if}}">{{ verdictWord }}</span>
               </summary>
               <div class="fhcs-band-body">
                  {{> "modules/fhcs/templates/chat/parts/d20-row.hbs" }}
                  {{#if words.length}}<span class="fhcs-band-words">{{#each words}}<span>{{ this }}</span>{{/each}}</span>{{/if}}
                  {{#each mathLines}}<p class="fhcs-band-math"><span class="fhcs-band-note">{{ formula }}</span><br>{{ result }}</p>{{/each}}
                  {{#each notes}}<p class="fhcs-band-note">{{ this }}</p>{{/each}}
                  {{> "modules/fhcs/templates/chat/parts/bonus.hbs" }}
               </div>
            </details>
            {{#if canResist}}
            <button type="button" class="fhcs-button" data-action="resistSave">{{ resistLabel }}</button>
            {{/if}}
         </li>
         {{/each}}
      </ul>
      {{/if}}
   </div>
   {{else if rolled}}
   {{> "modules/fhcs/templates/chat/parts/rolled-band.hbs" }}
   {{else}}
   <button type="button" class="fhcs-band fhcs-band-{{ kind }}" data-action="{{ action }}" data-index="{{ index }}">
      <span class="fhcs-band-top"><span class="fhcs-band-heading">{{ heading }}</span><span class="fhcs-band-end"></span></span>
      <span class="fhcs-band-text">{{ text }}</span>
   </button>
   {{/if}}
   {{/each}}

   {{#if showTargets}}<recorded-targets></recorded-targets>{{/if}}

   {{#if fhcs.apply}}
   {{!-- Folded until opened (user, 2026-10-24); the trays inside are unfolded. --}}
   <details class="fhcs-apply" data-fold-key="apply">
      <summary class="fhcs-apply-summary"><span class="fhcs-band-heading">{{ fhcs.apply.heading }}</span><span class="fhcs-band-end" aria-hidden="true"></span></summary>
      <div class="fhcs-apply-body">
         <p class="fhcs-band-note">{{ fhcs.apply.note }}</p>
         {{#if fhcs.apply.damageId}}
         {{!-- dnd5e's tray reads its damage, and each token's save, from the nearest message id: the damage roll. --}}
         <div class="fhcs-apply-damage" data-message-id="{{ fhcs.apply.damageId }}">
            <damage-application class="dnd5e2" open></damage-application>
         </div>
         {{/if}}
         {{#if effects.length}}
         <effect-application class="dnd5e2" open>
            {{#each effects}}
            <option value="{{ uuid }}"></option>
            {{/each}}
         </effect-application>
         {{/if}}
      </div>
   </details>
   {{/if}}

   {{#if fhcs.applied.length}}
   {{!-- What Apply did (user, 2026-10-28): kept on the card, open, whatever is selected or targeted next. --}}
   <div class="fhcs-applied">
      <span class="fhcs-band-heading">{{ fhcs.appliedHeading }}</span>
      <ul class="fhcs-applied-list">
         {{#each fhcs.applied}}<li>{{ text }}</li>{{/each}}
      </ul>
   </div>
   {{/if}}

   {{#if fhcs.others.length}}
   <div class="fhcs-card-actions">
      {{#each fhcs.others}}
      <button type="button" class="fhcs-button" data-action="{{ action }}" data-index="{{ index }}">{{ label }}</button>
      {{/each}}
   </div>
   {{/if}}
</div>

{{#each summaries}}
<div class="card-summary" data-message-id="{{ id }}" data-target-uuid="{{ token.uuid }}">{{{ html }}}</div>
{{/each}}
