<div class="fhcs-outcome{{#if verdict}} fhcs-outcome-{{ verdict }}{{/if}}">
   <p class="fhcs-outcome-head">
      {{#if who}}<span class="fhcs-outcome-who">{{ who }}</span>{{/if}}
      {{#if what}}<span class="fhcs-outcome-what">{{ what }}</span>{{/if}}
      <strong class="fhcs-outcome-total">{{ total }}</strong>
   </p>
   {{#if details.length}}
   <p class="fhcs-outcome-details">
      {{#each details}}<span class="fhcs-outcome-detail">{{ this }}</span>{{/each}}
   </p>
   {{/if}}
</div>
