{{!-- One Spellbook row (SCOPE §4.7), included by spellbook.hbs with its section's `showUses`. Built like an
      Inventory row (item-row.hbs) so dnd5e's inventory element binds it the same way: the picture casts (use), the
      name opens dnd5e's summary (toggleExpand), the book flips preparation (prepare), and the context menu and drag
      work on the row. The tint and left edge follow the preparation kind; favorites add a bookmark and a glow. --}}
<li class="item collapsible fhcs-item fhcs-spell{{#unless expanded}} collapsed{{/unless}}{{#if kind}} fhcs-kind-{{ kind }}{{/if}}{{#if favorite}} fhcs-favorited{{/if}}"
    data-uuid="{{ uuid }}" data-item-id="{{ id }}" data-entry-id="{{ id }}" data-item-name="{{ name }}">
   <div class="item-row draggable fhcs-item-row">
      <button type="button" class="item-action fhcs-col-img fhcs-item-use {{ @root.rollableClass }}"
              data-action="use" aria-label="{{ useLabel }}">
         <img src="{{ img }}" alt="">
      </button>
      {{!-- dnd5e's expand flips the classes on this button's <i>, so it must have one. --}}
      <button type="button" class="item-action fhcs-col-name fhcs-item-name" data-action="toggleExpand"
              aria-label="{{ detailsLabel }}">
         <i class="fhcs-expand" aria-hidden="true"></i>
         <span class="fhcs-body fhcs-item-title">{{ name }}</span>
         {{#if favorite}}<svg class="fhcs-icon fhcs-fav-mark" viewBox="0 0 24 24" role="img" aria-label="{{ favoriteLabel }}"><path d="M6 3h12v18l-6-4-6 4z"/></svg>{{/if}}
         {{#if ritual}}<span class="fhcs-label fhcs-muted" role="img" aria-label="{{ ritualLabel }}">R</span>{{/if}}
         {{#if sub}}<span class="fhcs-label fhcs-muted fhcs-item-sub">{{ sub }}</span>{{/if}}
      </button>
      {{#with @root.fhcsSpellbook.columns}}
      {{#if components}}<span class="fhcs-body fhcs-col-components">{{ ../components }}</span>{{/if}}
      {{#if concentration}}
      <span class="fhcs-col-conc">
         {{#if ../conc}}<span class="fhcs-label fhcs-conc-mark{{#if ../conc.holding}} fhcs-on{{/if}}" role="img" aria-label="{{ ../conc.label }}">C</span>{{/if}}
      </span>
      {{/if}}
      {{#if time}}<span class="fhcs-body fhcs-col-time">{{ ../time }}</span>{{/if}}
      {{#if range}}<span class="fhcs-body fhcs-col-range">{{ ../range }}</span>{{/if}}
      {{#if school}}<span class="fhcs-body fhcs-col-school">{{ ../school }}</span>{{/if}}
      {{#if target}}<span class="fhcs-body fhcs-col-target">{{ ../target }}</span>{{/if}}
      {{/with}}
      {{#if showUses}}
      <span class="fhcs-col-uses">
         {{#if uses}}
         <input type="text" class="fhcs-input fhcs-body fhcs-uses-input" value="{{ uses.value }}" placeholder="0"
                data-dtype="Number" data-name="{{ uses.prop }}" inputmode="numeric" pattern="[+=\-]?\d*"
                aria-label="{{ uses.label }}">
         <span class="fhcs-body fhcs-muted">/ {{ uses.max }}</span>
         {{/if}}
      </span>
      {{/if}}
      <span class="fhcs-col-toggle">
         {{#if prep}}
         <button type="button" class="item-action fhcs-toggle fhcs-toggle-prep" data-action="prepare"
                 aria-pressed="{{#if prep.pressed}}true{{else}}false{{/if}}" aria-label="{{ prep.label }}"
                 data-fhcs-tip="{{ prep.label }}"{{#if prep.locked}} aria-disabled="true"{{/if}}>
            <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5c3-1.2 6-1 9 1 3-2 6-2.2 9-1V19c-3-1.2-6-1-9 1-3-2-6-2.2-9-1z"/><path class="fhcs-spine" d="M12 6.5V20"/></svg>
            {{#if prep.locked}}<svg class="fhcs-prep-lock" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="10" width="18" height="12" rx="2"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/></svg>{{/if}}
         </button>
         {{/if}}
      </span>
      {{#if @root.fhcsSpellbook.editing}}
      <span class="fhcs-col-edit">
         <button type="button" class="item-action fhcs-toggle" data-action="edit" aria-label="{{ editLabel }}" data-fhcs-tip="{{ editLabel }}">
            <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z"/></svg>
         </button>
         <button type="button" class="item-action fhcs-toggle" data-action="delete" aria-label="{{ deleteLabel }}" data-fhcs-tip="{{ deleteLabel }}">
            <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M10 7V4h4v3M7 7l1 13h8l1-13"/></svg>
         </button>
      </span>
      {{/if}}
   </div>
   <div class="item-description collapsible-content fhcs-item-details">
      <div class="wrapper fhcs-body">{{{ summary }}}</div>
   </div>
</li>
