{{!-- The Spellbook tab (SCOPE §4.7): one card per casting class, the concentration bar, then the spells by section
      on dnd5e's own inventory element, as on Inventory (inventory.hbs). It takes dnd5e's "spells" part ID. --}}
<section class="tab fhcs-list-tab fhcs-spellbook {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
   {{#with fhcsSpellbook}}
   <div class="fhcs-casting fhcs-plate">
      {{#if classes.length}}
      <div class="fhcs-casting-classes">
         {{#each classes}}
         {{!-- dnd5e's setSpellcastingAbility reads the ability from the nearest [data-ability]. --}}
         <div class="fhcs-casting-class fhcs-frame{{#if primary}} fhcs-primary{{/if}}" data-ability="{{ ability }}">
            <span class="fhcs-label fhcs-casting-name">{{ label }}</span>
            {{#unless npc}}{{#if ../editing}}<button type="button" class="fhcs-toggle fhcs-radio" data-action="setSpellcastingAbility"
                    aria-pressed="{{#if primary}}true{{else}}false{{/if}}" aria-label="{{ primaryLabel }}" data-fhcs-tip="{{ primaryLabel }}"><span class="fhcs-radio-mark" aria-hidden="true"></span></button>{{/if}}{{/unless}}
            {{#if ownCasting}}{{#if ../editing}}
            {{!-- An NPC with no casting class (SCOPE §4.13): its ability from a tray of chips, as a skill's. --}}
            <span class="fhcs-stat">
               <details class="fhcs-fold fhcs-ability-pick fhcs-casting-ability" data-fold-key="casting-ability">
                  <summary class="fhcs-label fhcs-muted" aria-label="{{ abilityLabel }}" data-fhcs-tip="{{ abilityLabel }}">{{ abbr }}<svg class="fhcs-pick-mark" viewBox="0 0 8 4" aria-hidden="true"><path d="M0 0h8L4 4z"/></svg></summary>
                  <div class="fhcs-tray fhcs-tray-row">
                     {{#each abilities}}
                     <button type="button" class="fhcs-chip fhcs-label{{#if selected}} fhcs-on{{/if}}" data-action="fhcsSpellAbility" data-fhcs-ability="{{ key }}"
                             aria-pressed="{{#if selected}}true{{else}}false{{/if}}">{{ abbr }}</button>
                     {{/each}}
                  </div>
               </details>
               <span class="fhcs-display">{{ mod }}</span>
            </span>
            {{else}}<span class="fhcs-stat"><span class="fhcs-label fhcs-muted">{{ abbr }}</span><span class="fhcs-display">{{ mod }}</span></span>{{/if}}
            {{else}}<span class="fhcs-stat"><span class="fhcs-label fhcs-muted">{{ abbr }}</span><span class="fhcs-display">{{ mod }}</span></span>{{/if}}
            <span class="fhcs-stat"><span class="fhcs-label fhcs-muted">{{ ../text.attack }}</span><span class="fhcs-display">{{ attack }}</span></span>
            <span class="fhcs-stat"><span class="fhcs-label fhcs-muted">{{ ../text.save }}</span><span class="fhcs-display">{{ save }}</span></span>
            {{#if npc}}
            {{!-- An NPC's caster level in Prepared's place (dnd5e's NPC card); its own, typed in edit mode. --}}
            <span class="fhcs-stat"><span class="fhcs-label fhcs-muted">{{ levelLabel }}</span>{{#if ownCasting}}{{#if ../editing}}<input type="text" class="fhcs-input fhcs-display fhcs-caster-level"
                  name="system.attributes.spell.level" data-dtype="Number" value="{{ levelSource }}" placeholder="—" aria-label="{{ levelLabel }}">{{else}}<span class="fhcs-display">{{ level }}</span>{{/if}}{{else}}<span class="fhcs-display">{{ level }}</span>{{/if}}</span>
            {{else}}
            <span class="fhcs-stat" role="group" aria-label="{{ preparedLabel }}"><span class="fhcs-label fhcs-muted">{{ ../text.prepared }}</span><span class="fhcs-display">{{ prepared }}</span></span>
            {{/if}}
         </div>
         {{/each}}
      </div>
      {{/if}}
      {{!-- What the character is concentrating on, always in this place (user, 2026-10-26). The save rolls through
            dnd5e's roll action, which reads the ability from [data-ability]. --}}
      <div class="fhcs-concentration fhcs-frame{{#if concentration.on}} fhcs-on{{/if}}" data-ability="concentration">
         <span class="fhcs-conc-mark" role="img" aria-label="{{ text.concentration }}">{{> "modules/fhcs/templates/sheet/conc-c.hbs" }}</span>
         {{#each concentration.spells}}
         <span class="fhcs-conc-spell" data-effect-id="{{ effectId }}">
            <img class="fhcs-conc-img" src="{{ img }}" alt="">
            <button type="button" class="fhcs-conc-open" data-action="fhcsOpenConcentration" data-item-id="{{ itemId }}"
                    aria-label="{{ openLabel }}"{{#unless itemId}} disabled{{/unless}}>
               <span class="fhcs-body fhcs-conc-name">{{ name }}</span>
               {{#if sub}}<span class="fhcs-body fhcs-muted">{{ sub }}</span>{{/if}}
            </button>
            <button type="button" class="fhcs-button fhcs-body fhcs-conc-end" data-action="fhcsEndConcentration"
                    data-effect-id="{{ effectId }}" aria-label="{{ endLabel }}">{{ ../text.end }}</button>
         </span>
         {{else}}
         <span class="fhcs-body fhcs-conc-none">{{ text.none }}</span>
         {{/each}}
         <button type="button" class="fhcs-button fhcs-body fhcs-conc-save {{ @root.rollableClass }}" data-action="roll"
                 data-type="ability" aria-label="{{ concentration.saveLabel }}">{{ text.conSave }} {{ concentration.save }}</button>
      </div>
   </div>

   <dnd5e-inventory class="inventory-element fhcs-list-element">
      {{> "modules/fhcs/templates/sheet/list-bar.hbs" list="spells" }}

      <section class="items-list spells-list fhcs-items" data-item-list="spells">
         {{#each sections}}
         <div class="items-section fhcs-section{{#unless fold.open}} fhcs-folded{{/unless}} fhcs-plate" data-fhcs-fold="{{ fold.key }}" data-fhcs-section="{{ id }}" data-level="{{ level }}" data-method="{{ method }}">
            <div class="items-header fhcs-item-head">
               {{!-- The fold (user, 2026-10-28): its caret in the picture column, then the name; the slot pips stay outside
                     it, so a pip click never folds. --}}
               <span class="fhcs-col-name fhcs-spell-head">
                  <button type="button" class="fhcs-section-toggle" data-action="fhcsToggleSection" aria-expanded="{{#if fold.open}}true{{else}}false{{/if}}"><span class="fhcs-section-caret" aria-hidden="true"><svg class="fhcs-icon fhcs-caret" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg></span><span class="fhcs-label">{{ label }}</span></button>
                  {{#if slots}}
                  <span class="fhcs-slots" data-prop="{{ slots.prop }}">
                     {{#each slots.pips}}
                     <button type="button" class="fhcs-slot{{#if filled}} fhcs-on{{/if}}{{#if temp}} fhcs-temp{{/if}}" data-action="togglePip"
                             data-n="{{ n }}" aria-pressed="{{#if filled}}true{{else}}false{{/if}}" aria-label="{{ label }}"></button>
                     {{/each}}
                  </span>
                  {{/if}}
               </span>
               {{#if ../columns.components}}<span class="fhcs-label fhcs-muted fhcs-col-components">{{ ../text.head.components }}</span>{{/if}}
               {{#if ../columns.concentration}}<span class="fhcs-muted fhcs-col-conc" role="img" aria-label="{{ ../text.head.concentration }}">{{> "modules/fhcs/templates/sheet/conc-c.hbs" }}</span>{{/if}}
               {{#if ../columns.time}}<span class="fhcs-label fhcs-muted fhcs-col-time">{{ ../text.head.time }}</span>{{/if}}
               {{#if ../columns.range}}<span class="fhcs-label fhcs-muted fhcs-col-range">{{ ../text.head.range }}</span>{{/if}}
               {{#if ../columns.school}}<span class="fhcs-label fhcs-muted fhcs-col-school">{{ ../text.head.school }}</span>{{/if}}
               {{#if ../columns.target}}<span class="fhcs-label fhcs-muted fhcs-col-target">{{ ../text.head.target }}</span>{{/if}}
               {{#if showUses}}<span class="fhcs-label fhcs-muted fhcs-col-uses">{{ ../text.uses }}</span>{{/if}}
               {{!-- The prepared column, empty in a heading: in edit mode the slots' gear (user, 2026-10-28: the edit
                     column holds the section's arrows). --}}
               {{#if ../editing}}{{#if slots}}
               <span class="fhcs-col-toggle"><button type="button" class="fhcs-toggle fhcs-gear-button" data-action="showConfiguration" data-config="spellSlots"
                       aria-label="{{ ../text.slotsConfig }}" data-fhcs-tip="{{ ../text.slotsConfig }}">{{> "modules/fhcs/templates/sheet/gear.hbs" }}</button></span>
               {{else}}<span class="fhcs-col-toggle" role="img" aria-label="{{ ../text.prep }}"></span>{{/if}}
               {{else}}<span class="fhcs-col-toggle" role="img" aria-label="{{ ../text.prep }}"></span>{{/if}}
               {{#if ../columns.favorite}}<span class="fhcs-muted fhcs-col-toggle" role="img" aria-label="{{ ../text.head.favorite }}"><svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"/></svg></span>{{/if}}
               {{#if ../editing}}
               <span class="fhcs-col-edit">{{#if move}}{{> "modules/fhcs/templates/sheet/section-move.hbs" }}{{/if}}</span>
               {{/if}}
            </div>
            <ol class="item-list fhcs-item-list">
               {{#each items}}{{> "modules/fhcs/templates/sheet/spell-row.hbs" showUses=../showUses }}{{/each}}
            </ol>
         </div>
         {{/each}}
         {{#if empty}}<p class="fhcs-body fhcs-muted fhcs-empty fhcs-plate">{{ text.empty }}</p>{{/if}}
      </section>
   </dnd5e-inventory>
   {{/with}}
</section>
