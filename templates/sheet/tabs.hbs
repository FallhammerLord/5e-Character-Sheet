{{!-- Classic's tab row across the top (SCOPE §4.2), with the sheet lock at its right end. Foundry's `tab` action
      switches tabs; dnd5e's `changeMode` switches play and edit. Foundry finds tab buttons only as children of
      `.tabs`, so the row keeps that class (the layout check fails without it). --}}
{{#*inline "fhcs-star-mark"}}<span class="fhcs-mark" aria-hidden="true"></span>{{/inline}}
{{#*inline "fhcs-bank-stars"}}{{#each stars}}<button type="button" class="fhcs-star{{#if filled}} fhcs-on{{/if}}{{#if last}} fhcs-star-last{{/if}}{{#if cooled}} fhcs-star-cooled{{/if}}"
   data-action="fhcsInspiration" data-slot="{{ slot }}" aria-label="{{ label }}" aria-pressed="{{#if filled}}true{{else}}false{{/if}}" data-fhcs-tip="{{ label }}"{{#unless can}} disabled{{/unless}}>{{> fhcs-star-mark }}</button>{{/each}}{{/inline}}
<nav class="tabs fhcs-tabs" data-group="primary" aria-label="{{ fhcsTabs.label }}">
   {{#each fhcsTabs.tabs}}
   <button type="button" class="fhcs-tab fhcs-body{{#if active}} active{{/if}}" data-action="tab" data-group="primary"
           data-tab="{{ id }}">{{ label }}</button>
   {{/each}}
   {{!-- Inspiration at the row's right, before the lock (SCOPE §4.12, user 2026-10-28): one star (dnd5e's on or off)
         or the bank, a star per use, any one spent or banked by a click; a count stands in for a big bank or a narrow row, its tray
         holding the stars. Edit mode's gear sits at the bar's left, so the stars don't move on the lock. --}}
   {{#with fhcsTabs.inspiration}}
   <div class="fhcs-inspiration{{#if onlyCompact}} fhcs-inspiration-compact{{/if}}" data-fhcs-count="{{ count }}" role="group" aria-label="{{ label }}">
      {{#if link}}
      <details class="fhcs-fold fhcs-inspiration-link" data-fold-key="inspiration">
         <summary class="fhcs-toggle fhcs-gear-button" aria-label="{{ link.label }}" data-fhcs-tip="{{ link.label }}">{{> "modules/fhcs/templates/sheet/gear.hbs" }}</summary>
         <div class="fhcs-tray fhcs-inspiration-tray">
            <span class="fhcs-label">{{ link.title }}</span>
            {{#each link.options}}
            <button type="button" class="fhcs-button fhcs-body fhcs-resource-option" data-action="fhcsLinkInspiration" data-item-id="{{ id }}"
                    aria-pressed="{{#if on}}true{{else}}false{{/if}}">
               <span class="fhcs-radio-mark" aria-hidden="true"></span>{{#if img}}<img class="fhcs-resource-img" src="{{ img }}" alt="">{{/if}}<span class="fhcs-resource-name">{{ name }}</span>
            </button>
            {{/each}}
         </div>
      </details>
      {{/if}}
      {{#if bank}}
      {{#unless onlyCompact}}
      <span class="fhcs-inspiration-stars" aria-label="{{ countLabel }}">{{> fhcs-bank-stars }}</span>
      {{/unless}}
      <details class="fhcs-fold fhcs-inspiration-count" data-fold-key="inspiration-bank">
         <summary class="fhcs-star fhcs-star-count{{#if value}} fhcs-on{{/if}}" aria-label="{{ countLabel }}" data-fhcs-tip="{{ label }}">{{> fhcs-star-mark }}<span class="fhcs-label">{{ value }}/{{ max }}</span></summary>
         <div class="fhcs-tray fhcs-inspiration-bank-tray">
            <span class="fhcs-label">{{ name }}</span>
            <span class="fhcs-tray-stars" aria-label="{{ countLabel }}">{{> fhcs-bank-stars }}</span>
         </div>
      </details>
      {{else}}
      <button type="button" class="fhcs-star{{#if on}} fhcs-on fhcs-star-last{{else}} fhcs-star-cooled{{/if}}" data-action="toggleInspiration" aria-pressed="{{#if on}}true{{else}}false{{/if}}"
              aria-label="{{ label }}" data-fhcs-tip="{{ label }}"{{#unless canEdit}} disabled{{/unless}}>{{> fhcs-star-mark }}</button>
      {{/if}}
   </div>
   {{/with}}
   {{#if fhcsTabs.canEdit}}
   <button type="button" class="fhcs-button fhcs-lock" data-action="changeMode" aria-pressed="{{#if fhcsTabs.editing}}true{{else}}false{{/if}}"
           aria-label="{{ fhcsTabs.lockLabel }}" data-fhcs-tip="{{ fhcsTabs.lockLabel }}">
      {{#if fhcsTabs.editing}}
      <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 7.5-2"/></svg>
      {{else}}
      <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
      {{/if}}
   </button>
   {{/if}}
</nav>
