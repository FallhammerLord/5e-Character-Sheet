{{!-- Removes a class, subclass, species or background from its card on the Features tab, in edit mode: dnd5e's
      deleteDocument, which asks first (and offers to undo the item's advancements). Takes `uuid` and `label`. --}}
<button type="button" class="fhcs-toggle fhcs-origin-clear" data-action="deleteDocument" data-uuid="{{ uuid }}"
        aria-label="{{ label }}" data-fhcs-tip="{{ label }}">
   <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
</button>
