{{#*inline "fhcs-resources"}}
      {{!-- Resources (user, 2026-10-28, SCOPE §4.10): three panels in a row, first among the favorites, folding like the
            other groups. In play only those set show; with the lock off all three, for editing and adding. Each panel:
            name; uses left / most; recovery and Restore. A panel linked to an item (the cog's tray) shows its uses. --}}
      <div class="fhcs-group fhcs-frame fhcs-resources-panel" data-fhcs-group="resources">
         <div class="fhcs-group-head">
            <button type="button" class="fhcs-group-toggle" data-action="fhcsToggleGroup" aria-expanded="{{#if resourcesOpen}}true{{else}}false{{/if}}">
               <svg class="fhcs-icon fhcs-caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
               <span class="fhcs-label">{{ text.resources }}</span>
            </button>
         </div>
         <ul class="fhcs-favorites fhcs-resources"{{#unless resourcesOpen}} hidden{{/unless}}>
            {{#each resources}}
            <li class="fhcs-resource fhcs-frame{{#if linked}} fhcs-resource-linked{{/if}}" role="group" aria-label="{{ groupLabel }}" data-resource="{{ key }}">
               {{!-- A linked item's art as the panel's underlay (user, 2026-10-28), as the header's cards carry theirs. --}}
               {{#if link}}<span class="fhcs-resource-art" aria-hidden="true"><img src="{{ link.img }}" alt=""></span>{{/if}}
               <span class="fhcs-resource-head">
                  {{#if ../editing}}{{#unless linked}}
                  <input type="text" class="fhcs-input fhcs-body fhcs-resource-field" name="system.resources.{{ key }}.label" value="{{ label }}"
                         placeholder="{{ title }}" aria-label="{{ nameLabel }}">
                  {{else}}
                  <span class="fhcs-body fhcs-resource-name">{{ title }}</span>
                  {{/unless}}
                  <details class="fhcs-fold fhcs-resource-link" data-fold-key="resource-{{ key }}">
                     <summary class="fhcs-toggle fhcs-gear-button" aria-label="{{ linkLabel }}" data-fhcs-tip="{{ linkLabel }}">{{> "modules/fhcs/templates/sheet/gear.hbs" }}</summary>
                     <div class="fhcs-tray fhcs-resource-tray">
                        <span class="fhcs-label">{{ ../text.linkTitle }}</span>
                        {{#each options}}
                        <button type="button" class="fhcs-button fhcs-body fhcs-resource-option" data-action="fhcsLinkResource" data-key="{{ ../key }}"
                                data-item-id="{{ id }}" aria-pressed="{{#if on}}true{{else}}false{{/if}}">
                           <span class="fhcs-radio-mark" aria-hidden="true"></span>{{#if img}}<img class="fhcs-resource-img" src="{{ img }}" alt="">{{/if}}<span class="fhcs-resource-name">{{ name }}</span>
                        </button>
                        {{/each}}
                     </div>
                  </details>
                  {{else}}
                  <span class="fhcs-body fhcs-resource-name{{#unless named}} fhcs-muted{{/unless}}">{{ title }}</span>
                  {{/if}}
               </span>
               <span class="fhcs-resource-count">
                  {{#if linked}}
                  {{!-- Not a form field: the item's uses, saved by our change handler (it stores what's spent). --}}
                  <input type="text" class="fhcs-input fhcs-body" data-fhcs-resource-uses="{{ key }}" inputmode="numeric"
                         value="{{ value }}" placeholder="0" aria-label="{{ valueLabel }}">
                  {{else}}
                  <input type="text" class="fhcs-input fhcs-body" name="system.resources.{{ key }}.value" data-dtype="Number" inputmode="numeric"
                         value="{{ value }}" placeholder="0" aria-label="{{ valueLabel }}">
                  {{/if}}
                  <span class="fhcs-body fhcs-muted">/</span>
                  {{#if ../editing}}{{#unless linked}}
                  <input type="text" class="fhcs-input fhcs-body" name="system.resources.{{ key }}.max" data-dtype="Number" inputmode="numeric"
                         value="{{ sourceMax }}" placeholder="0" aria-label="{{ maxLabel }}">
                  {{else}}
                  <span class="fhcs-body fhcs-resource-max">{{ max }}</span>
                  {{/unless}}{{else}}
                  <span class="fhcs-body fhcs-resource-max">{{ max }}</span>
                  {{/if}}
               </span>
               <span class="fhcs-resource-foot">
                  {{#if ../editing}}{{#unless linked}}
                  <span class="fhcs-resource-recovery">
                     <label class="fhcs-label fhcs-muted"><input type="checkbox" name="system.resources.{{ key }}.sr"{{#if sr}} checked{{/if}}>{{ ../text.shortRest }}</label>
                     <label class="fhcs-label fhcs-muted"><input type="checkbox" name="system.resources.{{ key }}.lr"{{#if lr}} checked{{/if}}>{{ ../text.longRest }}</label>
                  </span>
                  {{else}}
                  <span class="fhcs-label fhcs-muted fhcs-resource-recovery">{{ recovery }}</span>
                  {{/unless}}{{else}}
                  <span class="fhcs-label fhcs-muted fhcs-resource-recovery">{{ recovery }}</span>
                  {{/if}}
                  <button type="button" class="fhcs-toggle fhcs-resource-refresh" data-action="fhcsRefreshResource" data-key="{{ key }}"
                          aria-label="{{ refreshLabel }}" data-fhcs-tip="{{ refreshLabel }}">
                     <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.7"/><path d="M20 4v5h-5"/></svg>
                  </button>
               </span>
            </li>
            {{/each}}
         </ul>
      </div>
{{/inline}}
{{!-- The Attributes tab (SCOPE §4.3): skills and traits on the left, favorites on the right. It takes dnd5e's
      "details" tab, so dnd5e's tab switching and part ID still apply. --}}
<section class="tab fhcs-attributes {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
   {{#with fhcsAttributes}}
   <div class="fhcs-attributes-side">
      <div class="fhcs-panel">
         <div class="fhcs-panel-head">
            <span class="fhcs-label">{{ text.skills }}</span>
            {{#if editing}}
            <button type="button" class="fhcs-toggle fhcs-gear-button" data-action="showConfiguration" data-config="skills"
                    aria-label="{{ text.skillsConfig }}" data-fhcs-tip="{{ text.skillsConfig }}">{{> "modules/fhcs/templates/sheet/gear.hbs" }}</button>
            {{/if}}
         </div>
         <ul class="fhcs-skills">
            {{#each skills}}
            {{!-- dnd5e's roll action reads the skill from the nearest data-key. --}}
            {{!-- One row in both modes, as dnd5e builds its own (character-details.hbs, .skill-prof): the same cells, each
                  a fixed 24px, so edit mode swaps what a cell holds and nothing else moves (SCOPE §5.2 rule 6). Play
                  mode's mark stays drawn in edit mode too: dnd5e's proficiency cycle draws in its own shadow DOM, out of
                  our styles' reach, so it lies over the mark unseen, takes the click and saves; the redraw shows the new
                  mark (user's screenshots, 2026-10-27). In play the name's button covers the whole row. --}}
            <li class="fhcs-skill{{#unless ../editing}} fhcs-skill-play{{/unless}}" data-key="{{ key }}">
               <span class="fhcs-prof-slot">
                  <span class="fhcs-prof-mark fhcs-prof-{{ mark }}" aria-hidden="true"></span>
                  {{#if ../editing}}
                  <proficiency-cycle class="fhcs-prof-cycle" type="skill" name="system.skills.{{ key }}.value" value="{{ source }}"
                                     aria-label="{{ profLabel }}" data-fhcs-tip="{{ profLabel }}"></proficiency-cycle>
                  {{/if}}
               </span>
               <button type="button" class="fhcs-skill-roll fhcs-body {{ @root.rollableClass }}" data-action="roll" data-type="skill"
                       aria-label="{{ rollLabel }}"><span class="fhcs-skill-name">{{ label }}</span></button>
               {{#if ../editing}}
               {{!-- The ability opens a tray of our chips (user, 2026-10-27: the native dropdown failed contrast and its
                     dashed underline moved the text). A small triangle under the word marks it. --}}
               <details class="fhcs-fold fhcs-skill-ability fhcs-ability-pick" data-fold-key="skill-ability-{{ key }}">
                  <summary class="fhcs-label fhcs-muted" aria-label="{{ abilityLabel }}" data-fhcs-tip="{{ abilityLabel }}">{{ abbr }}<svg class="fhcs-pick-mark" viewBox="0 0 8 4" aria-hidden="true"><path d="M0 0h8L4 4z"/></svg></summary>
                  <div class="fhcs-tray fhcs-tray-row">
                     {{#each abilities}}
                     <button type="button" class="fhcs-chip fhcs-label{{#if selected}} fhcs-on{{/if}}" data-action="fhcsSkillAbility" data-fhcs-ability="{{ key }}"
                             aria-pressed="{{#if selected}}true{{else}}false{{/if}}">{{ abbr }}</button>
                     {{/each}}
                  </div>
               </details>
               {{else}}
               <span class="fhcs-label fhcs-muted fhcs-skill-ability">{{ abbr }}</span>
               {{/if}}
               <span class="fhcs-body fhcs-skill-mod">{{ mod }}</span>
               {{#if ../editing}}
               <button type="button" class="fhcs-toggle fhcs-gear-button fhcs-muted" data-action="showConfiguration" data-config="skill"
                       aria-label="{{ configLabel }}" data-fhcs-tip="{{ configLabel }}">{{> "modules/fhcs/templates/sheet/gear.hbs" }}</button>
               {{else}}
               <span class="fhcs-label fhcs-muted fhcs-skill-passive">{{ passive }}</span>
               {{/if}}
            </li>
            {{/each}}
         </ul>
      </div>

   </div>

   <div class="fhcs-attributes-main">
      {{#if traits.length}}
      {{!-- Traits beside the skills, at the column's top (user, 2026-10-27): its heading on the Skills heading's line;
            it folds to one line of what's set, remembered like a favorites group. Every trait in both modes, one line
            each; edit mode adds a gear in the last column. --}}
      <div class="fhcs-panel fhcs-frame fhcs-traits-panel" data-fhcs-group="traits">
         <div class="fhcs-panel-head">
            <button type="button" class="fhcs-group-toggle" data-action="fhcsToggleGroup" aria-expanded="{{#if traitsOpen}}true{{else}}false{{/if}}">
               <svg class="fhcs-icon fhcs-caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
               <span class="fhcs-label">{{ text.traits }}</span>
            </button>
            <span class="fhcs-body fhcs-muted fhcs-line fhcs-traits-summary" data-fhcs-folded{{#if traitsOpen}} hidden{{/if}}>{{ traitsSummary }}</span>
            {{#if editing}}
            {{!-- dnd5e's Special Traits, a settings page: off the tab row since 2026-10-28 (the row's room went to
                  inspiration), opened from here like the other settings. --}}
            <button type="button" class="fhcs-toggle fhcs-gear-button fhcs-special-traits" data-action="fhcsSpecialTraits"
                    aria-label="{{ text.specialTraits }}" data-fhcs-tip="{{ text.specialTraits }}">{{> "modules/fhcs/templates/sheet/gear.hbs" }}</button>
            {{/if}}
         </div>
         <dl class="fhcs-traits"{{#unless traitsOpen}} hidden{{/unless}}>
            {{#each traits}}
            <dt class="fhcs-label fhcs-muted">{{ title }}</dt>
            <dd class="fhcs-body{{#if empty}} fhcs-muted{{/if}}">{{ text }}</dd>
            <dd class="fhcs-trait-gear">{{#if ../editing}}<button type="button" class="fhcs-toggle fhcs-gear-button fhcs-muted" data-action="showConfiguration"
                    {{#if config}}data-config="{{ config }}"{{else}}data-trait="{{ trait }}"{{/if}} aria-label="{{ configLabel }}" data-fhcs-tip="{{ configLabel }}">{{> "modules/fhcs/templates/sheet/gear.hbs" }}</button>{{/if}}</dd>
            {{/each}}
         </dl>
      </div>
      {{/if}}
      {{!-- Resources lead the column while any is set; with none set they show only in edit mode, at the column's foot,
            so nothing above moves when the lock opens (rule 6; user, 2026-10-28). --}}
      {{#if resourcesAtTop}}{{> fhcs-resources }}{{/if}}

      {{#each favorites}}
      {{!-- Each group folds and stays as the player left it (user, 2026-10-24); its slot pips sit outside the fold button. --}}
      <div class="fhcs-group fhcs-frame" data-fhcs-group="{{ key }}">
         <div class="fhcs-group-head">
            <button type="button" class="fhcs-group-toggle" data-action="fhcsToggleGroup" aria-expanded="{{#if open}}true{{else}}false{{/if}}">
               <svg class="fhcs-icon fhcs-caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
               <span class="fhcs-label">{{ label }}</span>
            </button>
            {{#if slots}}
            <span class="fhcs-slots" data-prop="{{ slots.prop }}">
               {{#each slots.pips}}
               <button type="button" class="fhcs-slot{{#if filled}} fhcs-on{{/if}}" data-action="togglePip" data-n="{{ n }}"
                       aria-pressed="{{#if filled}}true{{else}}false{{/if}}" aria-label="{{ label }}"></button>
               {{/each}}
            </span>
            {{/if}}
         </div>
         <ul class="fhcs-favorites"{{#unless open}} hidden{{/unless}}>
            {{#each rows}}
            {{!-- dnd5e's useFavorite reads these ids from the row and the button. --}}
            <li class="fhcs-favorite{{#if equipped}} fhcs-equipped{{/if}}{{#if prepared}} fhcs-prepared{{/if}}{{#if kind}} fhcs-kind-{{ kind }}{{/if}}{{#if expanded}} fhcs-open{{/if}}"
                data-favorite-id="{{ id }}"{{#if itemId}} data-item-id="{{ itemId }}"{{/if}}{{#if key}} data-key="{{ key }}"{{/if}}
                {{#if effectId}} data-effect-id="{{ effectId }}"{{/if}}{{#if activityId}} data-activity-id="{{ activityId }}"{{/if}}>
               {{!-- An item's picture uses it and its name opens its details, as on its own tab; anything else (a skill,
                     an effect) is one button. --}}
               {{#if expandable}}
               <button type="button" class="fhcs-favorite-pic {{ rollableClass }}" data-action="useFavorite"
                       {{#if activityId}}data-activity-id="{{ activityId }}"{{/if}} aria-label="{{ useLabel }}">
                  <img class="fhcs-favorite-img" src="{{ img }}" alt="">
               </button>
               <button type="button" class="fhcs-favorite-use" data-action="fhcsToggleFavoriteDetails"
                       aria-expanded="{{#if expanded}}true{{else}}false{{/if}}" aria-label="{{ detailsLabel }}">
                  <svg class="fhcs-icon fhcs-caret fhcs-name-caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
               {{else}}
               <img class="fhcs-favorite-img" src="{{ img }}" alt="">
               <button type="button" class="fhcs-favorite-use {{ rollableClass }}" data-action="useFavorite"
                       {{#if activityId}}data-activity-id="{{ activityId }}"{{/if}}>
               {{/if}}
                  <span class="fhcs-body fhcs-favorite-name">{{ title }}</span>
                  {{#if equipped}}<svg class="fhcs-icon fhcs-state" viewBox="0 0 24 24" role="img" aria-label="{{ stateLabel }}"><path d="M5 12l5 5 9-10"/></svg>{{/if}}
                  {{#if prepared}}<svg class="fhcs-icon fhcs-state fhcs-state-fill" viewBox="0 0 24 24" role="img" aria-label="{{ stateLabel }}"><path d="M3 5.5c3-1.2 6-1 9 1 3-2 6-2.2 9-1V19c-3-1.2-6-1-9 1-3-2-6-2.2-9-1z"/></svg>{{/if}}
               </button>
               <span class="fhcs-label fhcs-muted fhcs-favorite-detail">{{#if kindText}}{{ kindText }} · {{/if}}{{ subtitle }}</span>
               {{#if toggle}}
               {{!-- The Effects tab's switch; dnd5e's useFavorite flips the effect. --}}
               <span class="fhcs-favorite-uses">
                  <button type="button" class="fhcs-toggle fhcs-switch" data-action="useFavorite" aria-pressed="{{#if toggle.on}}true{{else}}false{{/if}}"
                          aria-label="{{ toggle.label }}" data-fhcs-tip="{{ toggle.label }}">
                     <svg class="fhcs-switch-mark" viewBox="0 0 20 12" aria-hidden="true"><rect x="1" y="1" width="18" height="10" rx="5"/><circle cy="6" r="3"/></svg>
                  </button>
               </span>
               {{else}}
               <span class="fhcs-body fhcs-favorite-uses">{{ uses }}</span>
               {{/if}}
               {{#if expanded}}<div class="fhcs-body fhcs-favorite-details">{{{ summary }}}</div>{{/if}}
            </li>
            {{/each}}
         </ul>
      </div>
      {{else}}
      <p class="fhcs-body fhcs-muted fhcs-empty">{{ text.noFavorites }}</p>
      {{/each}}
      {{#if resourcesAtFoot}}{{> fhcs-resources }}{{/if}}
   </div>
   {{/with}}
</section>
