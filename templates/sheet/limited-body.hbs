{{!-- The Limited view's body (SCOPE §4.15): the biography in the Biography tab's box, read only. It takes dnd5e's
      limited "biography" part, always the open tab: a Limited view has no tab row. --}}
<section class="tab fhcs-biography fhcs-limited-body active" data-tab="biography" data-group="primary">
   {{#with fhcsLimited}}
   {{#if biography}}
   <section class="fhcs-bio-box fhcs-bio-story">
      <h3 class="fhcs-label">{{ text.biography }}</h3>
      <div class="fhcs-body fhcs-bio-text">{{{ biography }}}</div>
   </section>
   {{else}}
   <p class="fhcs-body fhcs-muted fhcs-empty">{{ text.empty }}</p>
   {{/if}}
   {{/with}}
</section>
