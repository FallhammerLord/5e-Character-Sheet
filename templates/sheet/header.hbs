<header class="fhcs-header">
   {{#with fhcs}}
   <div class="fhcs-header-side">
      {{!-- The portrait card (SCOPE §4.1, user, 2026-10-27): one frame height for every art shape; the art fills it, and
            HP, Temp and Max ± sit on a band over its foot. The chips sit on the stage above the band. --}}
      <div class="fhcs-portrait{{#if death}} fhcs-dying{{/if}}">
         {{#with portrait}}
         {{#if isVideo}}
         <video class="fhcs-portrait-art fhcs-fit-{{ fit }}" src="{{ src }}" autoplay muted disablepictureinpicture loop playsinline
                {{#if @root.editable}}data-action="{{ action }}"{{else}}data-action="showArtwork"{{/if}}
                {{#if @root.editable}}{{#if path}}data-edit="{{ path }}" data-type="{{ type }}"{{/if}}{{/if}}></video>
         {{else}}
         <img class="fhcs-portrait-art fhcs-fit-{{ fit }}" src="{{ src }}" alt="{{ ../name }}"
              {{#if @root.editable}}data-action="{{ action }}"{{else}}data-action="showArtwork"{{/if}}
              {{#if @root.editable}}{{#if path}}data-edit="{{ path }}" data-type="{{ type }}"{{/if}}{{/if}}>
         {{/if}}
         {{/with}}

         <div class="fhcs-portrait-stage">
            {{!-- Corner chips. At exhaustion 0 the chip hides behind a dot until hovered (user, 2026-10-27). --}}
            <details class="fhcs-fold fhcs-corner-tl" data-fold-key="exhaustion">
               {{#if exhaustion.none}}
               <summary class="fhcs-exhaustion-dot" aria-label="{{ text.exhaustionShow }}">
                  <span class="fhcs-chip fhcs-label fhcs-dot-chip" aria-hidden="true"><svg class="fhcs-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 15h8M8.5 9.5h2M13.5 9.5h2"/></svg>0</span>
               </summary>
               {{else}}
               <summary class="fhcs-chip fhcs-label" aria-label="{{ exhaustion.label }}" data-fhcs-tip="{{ exhaustion.label }}">
                  <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 15h8M8.5 9.5h2M13.5 9.5h2"/></svg>{{ exhaustion.value }}
               </summary>
               {{/if}}
               <div class="fhcs-tray fhcs-tray-row" data-prop="system.attributes.exhaustion">
                  {{#each exhaustion.pips}}
                  <button type="button" class="fhcs-chip fhcs-label{{#if filled}} fhcs-on{{/if}}" data-action="togglePip" data-n="{{ n }}"
                          aria-pressed="{{#if filled}}true{{else}}false{{/if}}" aria-label="{{ label }}">{{ n }}</button>
                  {{/each}}
               </div>
            </details>

            <button type="button" class="fhcs-chip fhcs-corner-tr{{#if inspiration}} fhcs-on{{/if}}" data-action="toggleInspiration"
                    aria-pressed="{{#if inspiration}}true{{else}}false{{/if}}" aria-label="{{ text.inspiration }}"
                    data-fhcs-tip="{{ text.inspiration }}">
               <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg>
            </button>

            {{#if rests.length}}
            {{!-- One chip per rest, one click into dnd5e's rest dialog (user, 2026-10-27). --}}
            <div class="fhcs-rests fhcs-corner-bl">
               {{#each rests}}
               <button type="button" class="fhcs-chip" data-action="rest" data-type="{{ key }}" aria-label="{{ label }}" data-fhcs-tip="{{ label }}">
                  {{#if short}}
                  <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9h11v5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5z"/><path d="M16 10h1.5a2.5 2.5 0 0 1 0 5H16M8 3v3M11 3v3"/></svg>
                  {{else}}
                  <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18V8M3 14h18v4M21 14v-2a3 3 0 0 0-3-3h-7v5"/><circle cx="7" cy="11" r="1.6"/></svg>
                  {{/if}}
               </button>
               {{/each}}
            </div>
            {{/if}}

            <span class="fhcs-chip fhcs-chip-static fhcs-label fhcs-corner-br" role="img" aria-label="{{ hd.label }}">{{ hd.text }}</span>

            {{#if death}}
            {{!-- At 0 HP the death saves sit on the portrait, so the header keeps its size (user, 2026-10-24). --}}
            <div class="fhcs-death" role="group" aria-label="{{ death.rollLabel }}">
               <span class="fhcs-death-pips fhcs-death-success" data-prop="system.attributes.death.success">
                  {{#each death.success}}
                  <button type="button" class="fhcs-death-pip{{#if filled}} fhcs-on{{/if}}" data-action="togglePip" data-n="{{ n }}"
                          aria-pressed="{{#if filled}}true{{else}}false{{/if}}" aria-label="{{ label }}"></button>
                  {{/each}}
               </span>
               <button type="button" class="fhcs-chip {{ @root.rollableClass }}" data-action="roll" data-type="deathSave"
                       aria-label="{{ death.rollLabel }}" data-fhcs-tip="{{ death.rollLabel }}">
                  <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c-4.4 0-8 3.1-8 7 0 2.4 1.3 4.5 3.3 5.8V20h9.4v-4.2c2-1.3 3.3-3.4 3.3-5.8 0-3.9-3.6-7-8-7z"/><circle cx="9" cy="11" r="1.6"/><circle cx="15" cy="11" r="1.6"/><path d="M10.5 20v-2.5M13.5 20v-2.5"/></svg>
               </button>
               <span class="fhcs-death-pips fhcs-death-failure" data-prop="system.attributes.death.failure">
                  {{#each death.failure}}
                  <button type="button" class="fhcs-death-pip{{#if filled}} fhcs-on{{/if}}" data-action="togglePip" data-n="{{ n }}"
                          aria-pressed="{{#if filled}}true{{else}}false{{/if}}" aria-label="{{ label }}"></button>
                  {{/each}}
               </span>
            </div>
            {{/if}}
         </div>

         <div class="fhcs-portrait-band">
            {{#if @root.editable}}
            {{!-- Edit mode: dnd5e's meter markup; a click on it shows the field to set HP exactly (base-actor-sheet.mjs
                  #toggleMeter). --}}
            <div class="fhcs-hp meter">
               <div class="fhcs-hp-meter" role="meter" aria-valuemin="0" aria-valuenow="{{ hp.value }}" aria-valuemax="{{ hp.max }}"
                    aria-label="{{ hp.label }}">
                  <span class="fhcs-hp-fill" style="width: {{ hp.pct }}%"></span>
                  <span class="label fhcs-hp-line"><span class="fhcs-label">{{ text.hp }}</span><span class="fhcs-display">{{ hp.text }}</span></span>
                  <input type="text" class="fhcs-input fhcs-display" name="system.attributes.hp.value" data-dtype="Number"
                         data-max="{{ hp.max }}" value="{{ hp.value }}" placeholder="0" hidden>
               </div>
            </div>
            {{else if editable}}
            {{!-- Play mode: the bar opens the HP tray (user, 2026-10-27). Not dnd5e's meter markup, so its click-to-edit
                  stays out of the way. --}}
            <details class="fhcs-fold fhcs-hp-fold" data-fold-key="hp">
               <summary class="fhcs-hp-meter" aria-label="{{ hp.changeLabel }}">
                  <span class="fhcs-hp-fill" style="width: {{ hp.pct }}%"></span>
                  <span class="fhcs-hp-line"><span class="fhcs-label">{{ text.hp }}</span><span class="fhcs-display">{{ hp.text }}</span></span>
               </summary>
               <div class="fhcs-tray fhcs-hp-tray" data-hp="{{ hp.current }}" data-temp="{{ hp.tempValue }}">
                  <label class="fhcs-hp-amount"><span class="fhcs-label">{{ text.amount }}</span>
                     <input type="number" class="fhcs-input fhcs-display" min="1" step="1" autocomplete="off" data-fhcs-amount></label>
                  <div class="fhcs-hp-actions">
                     <button type="button" class="fhcs-button fhcs-body fhcs-hp-damage" data-action="fhcsHpChange" data-kind="damage"
                             aria-label="{{ text.damageLabel }}" data-fhcs-tip="{{ text.damageLabel }}">
                        <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/><path d="M12 7.4l-1.5 4 3 1.6-1.5 4"/></svg>{{ text.damage }}
                     </button>
                     <button type="button" class="fhcs-button fhcs-body" data-action="fhcsHpChange" data-kind="heal"
                             aria-label="{{ text.healLabel }}" data-fhcs-tip="{{ text.healLabel }}">
                        <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/><path d="M12 9.5v5M9.5 12h5"/></svg>{{ text.heal }}
                     </button>
                     <button type="button" class="fhcs-button fhcs-body" data-action="fhcsHpChange" data-kind="temp"
                             aria-label="{{ text.tempLabel }}" data-fhcs-tip="{{ text.tempLabel }}">
                        <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M12 9v6M9 12h6"/></svg>{{ text.giveTemp }}
                     </button>
                  </div>
                  <span class="fhcs-body fhcs-muted fhcs-hp-preview" aria-live="polite">{{ hp.preview }}</span>
               </div>
            </details>
            {{else}}
            <div class="fhcs-hp-meter" role="meter" aria-valuemin="0" aria-valuenow="{{ hp.value }}" aria-valuemax="{{ hp.max }}"
                 aria-label="{{ hp.label }}">
               <span class="fhcs-hp-fill" style="width: {{ hp.pct }}%"></span>
               <span class="fhcs-hp-line"><span class="fhcs-label">{{ text.hp }}</span><span class="fhcs-display">{{ hp.text }}</span></span>
            </div>
            {{/if}}
            <div class="fhcs-hp-fields">
               <label class="fhcs-label fhcs-muted" for="{{ @root.document.id }}-fhcs-temp">{{ text.temp }}</label>
               <input type="text" id="{{ @root.document.id }}-fhcs-temp" class="fhcs-input fhcs-body" name="system.attributes.hp.temp"
                      data-dtype="Number" inputmode="numeric" value="{{ hp.temp }}" placeholder="0">
               <label class="fhcs-label fhcs-muted" for="{{ @root.document.id }}-fhcs-tempmax">{{ text.maxMod }}</label>
               <input type="text" id="{{ @root.document.id }}-fhcs-tempmax" class="fhcs-input fhcs-body" name="system.attributes.hp.tempmax"
                      data-dtype="Number" inputmode="numeric" value="{{ hp.maxMod }}" placeholder="0" aria-label="{{ text.maxModLabel }}"
                      data-fhcs-tip="{{ text.maxModLabel }}">
            </div>
         </div>
      </div>
   </div>

   <div class="fhcs-header-main">
      <div class="fhcs-header-row">
         <span class="fhcs-display fhcs-name">{{ name }}</span>
         {{#if xp}}
         <div class="fhcs-xp">
            <div class="fhcs-bar" role="meter" aria-valuemin="0" aria-valuenow="{{ xp.value }}" aria-valuemax="{{ xp.max }}"
                 aria-label="{{ xp.text }}"><span style="width: {{ xp.pct }}%"></span></div>
            <span class="fhcs-body fhcs-muted">{{ xp.text }}</span>
         </div>
         {{#if levelUp}}
         {{!-- The level pill opens Level up (user, 2026-10-26); solid with an arrow once the XP is there. --}}
         <details class="fhcs-fold fhcs-level" data-fold-key="level-up">
            <summary class="fhcs-pill fhcs-label{{#if levelUp.ready}} fhcs-ready{{/if}}" aria-label="{{ levelUpLabel }}">
               {{#if levelUp.ready}}<svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>{{/if}}{{ level }}
               <svg class="fhcs-icon fhcs-caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="fhcs-tray fhcs-track">{{> "modules/fhcs/templates/sheet/level-up.hbs" levelUp }}</div>
         </details>
         {{else}}
         <span class="fhcs-pill fhcs-label">{{ level }}</span>
         {{/if}}
         {{/if}}
         {{#if milestones}}
         <details class="fhcs-fold fhcs-level" data-fold-key="milestones">
            <summary class="fhcs-pill fhcs-label" aria-label="{{ milestones.label }}">{{ level }}
               <svg class="fhcs-icon fhcs-caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="fhcs-tray fhcs-track">
               <div class="fhcs-track-head"><span class="fhcs-label">{{ text.milestones }}</span><span class="fhcs-label fhcs-muted">{{ milestones.filled }} / {{ milestones.total }}</span></div>
               <div class="fhcs-track-pips">
                  {{#each milestones.pips}}
                  <span class="fhcs-pip{{#if filled}} fhcs-on{{/if}}" role="img" aria-label="{{ label }}">{{#if img}}<img src="{{ img }}" alt="">{{/if}}</span>
                  {{/each}}
               </div>
               <div class="fhcs-track-key">
                  {{#each milestones.key}}
                  <span class="fhcs-body"><img src="{{ img }}" alt="">{{ text }}</span>
                  {{/each}}
               </div>
               {{#if levelUp}}{{> "modules/fhcs/templates/sheet/level-up.hbs" levelUp }}{{/if}}
            </div>
         </details>
         {{/if}}
      </div>
      <div class="fhcs-header-row">
         <span class="fhcs-label fhcs-muted fhcs-line">{{ origin }}{{#if origin}} · {{/if}}{{ speed }}</span>
         <span class="fhcs-label fhcs-nowrap">{{ text.proficiency }} {{ prof }}</span>
      </div>

      {{!-- One row, never wrapped (user, 2026-10-24): columns grow and shrink between limits; the sheet has a minimum width. --}}
      {{!-- The class, species and background cards share the grid's columns, under the abilities (user, 2026-10-26). --}}
      <div class="fhcs-abilities{{#if scoreFirst}} fhcs-score-first{{/if}}" style="--fhcs-columns: {{ columns }}">
         <div class="fhcs-ability">
            <span class="fhcs-label fhcs-muted">{{ text.ac }}</span>
            <span class="fhcs-shield" data-attribution="attributes.ac" data-attribution-caption="DND5E.ArmorClass">
               <svg viewBox="0 0 40 46" aria-hidden="true"><path d="M20 2l16 6v13c0 11-7 18-16 23C11 39 4 32 4 21V8z"/></svg>
               <span class="fhcs-display">{{ ac }}</span>
            </span>
         </div>
         <div class="fhcs-ability">
            <span class="fhcs-label fhcs-muted">{{ text.init }}</span>
            <button type="button" class="fhcs-button fhcs-display {{ @root.rollableClass }}" data-action="roll" data-type="initiative"
                    aria-label="{{ text.initLabel }}">{{ init }}</button>
         </div>
         {{#each abilities}}
         <div class="fhcs-ability" data-ability="{{ key }}">
            <span class="fhcs-label fhcs-muted">{{ abbr }}</span>
            <button type="button" class="fhcs-button fhcs-display ability-check {{ @root.rollableClass }}" data-action="roll"
                    data-type="ability" aria-label="{{ checkLabel }}">{{#if ../scoreFirst}}{{ score }}{{else}}{{ mod }}{{/if}}</button>
            <button type="button" class="fhcs-button fhcs-body saving-throw {{ @root.rollableClass }}" data-action="roll"
                    data-type="ability" aria-label="{{ saveLabel }}" data-fhcs-tip="{{ saveLabel }}">
               <span class="fhcs-prof{{#if proficient}} fhcs-on{{/if}}" aria-hidden="true"></span>{{ save }}
            </button>
            <span class="fhcs-label fhcs-muted">{{#if ../scoreFirst}}{{ mod }}{{else}}{{ score }}{{/if}}</span>
         </div>
         {{/each}}
         {{#each cards}}
         {{!-- Each card alike (SCOPE §4.8): the kind as a label, then the name, which opens the item, then a subclass on its
               own line; the item's art as a faded underlay; a dashed Subclass or Choose (dnd5e's findItem) where something
               is missing; in edit mode a remove (dnd5e's deleteDocument, which asks first) after the name. Two class
               cards at most: the last carries a "+N" chip opening the class tray (user, 2026-10-27). --}}
         <div class="fhcs-origin-card{{#if isClass}} fhcs-class-card{{/if}}" style="grid-column: span {{ span }}"{{#if item}} data-item-id="{{ item.id }}" data-uuid="{{ item.uuid }}"{{/if}}>
            {{#if art}}<span class="fhcs-origin-art" aria-hidden="true"><img class="fhcs-origin-underlay" src="{{ art }}" alt=""></span>{{/if}}
            <span class="fhcs-origin-text">
               <span class="fhcs-origin-head">
                  <span class="fhcs-label fhcs-muted fhcs-line">{{ kind }}</span>
                  {{#if more}}
                  <details class="fhcs-fold fhcs-more" data-fold-key="classes">
                     <summary class="fhcs-toggle fhcs-label fhcs-more-chip" aria-label="{{ more.label }}" data-fhcs-tip="{{ more.label }}">{{ more.text }}</summary>
                     <div class="fhcs-tray fhcs-class-tray">
                        <span class="fhcs-label">{{ more.title }}</span>
                        {{#each more.classes}}
                        <div class="fhcs-class-row" data-item-id="{{ item.id }}" data-uuid="{{ item.uuid }}">
                           <button type="button" class="fhcs-origin-name fhcs-body" data-action="showDocument" aria-label="{{ item.openLabel }}">{{ item.name }} {{ level }}</button>
                           {{#if sub}}
                           <span class="fhcs-origin-sub" data-uuid="{{ sub.uuid }}">
                              <button type="button" class="fhcs-origin-name fhcs-body fhcs-muted" data-action="showDocument" aria-label="{{ sub.openLabel }}">{{ sub.name }}</button>
                              {{#if sub.clear}}<button type="button" class="fhcs-toggle fhcs-origin-clear" data-action="deleteDocument" data-uuid="{{ sub.clear.uuid }}" aria-label="{{ sub.clear.label }}" data-fhcs-tip="{{ sub.clear.label }}"><svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>{{/if}}
                           </span>
                           {{/if}}
                           {{#if choose}}
                           <button type="button" class="fhcs-button fhcs-body fhcs-choose" data-action="findItem" data-item-type="{{ choose.type }}"
                                   {{#if choose.identifier}}data-class-identifier="{{ choose.identifier }}" {{/if}}aria-label="{{ choose.label }}">
                              <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>{{ choose.text }}
                           </button>
                           {{/if}}
                           {{#if item.clear}}<button type="button" class="fhcs-toggle fhcs-origin-clear" data-action="deleteDocument" data-uuid="{{ item.clear.uuid }}" aria-label="{{ item.clear.label }}" data-fhcs-tip="{{ item.clear.label }}"><svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>{{/if}}
                        </div>
                        {{/each}}
                     </div>
                  </details>
                  {{/if}}
               </span>
               <span class="fhcs-origin-line">
                  {{#if item}}
                  <button type="button" class="fhcs-origin-name fhcs-body" data-action="showDocument" aria-label="{{ item.openLabel }}">{{ item.name }}{{#if level}} {{ level }}{{/if}}</button>
                  {{#if item.clear}}<button type="button" class="fhcs-toggle fhcs-origin-clear" data-action="deleteDocument" data-uuid="{{ item.clear.uuid }}" aria-label="{{ item.clear.label }}" data-fhcs-tip="{{ item.clear.label }}"><svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>{{/if}}
                  {{/if}}
                  {{#if choose}}
                  <button type="button" class="fhcs-button fhcs-body fhcs-choose" data-action="findItem" data-item-type="{{ choose.type }}"
                          {{#if choose.identifier}}data-class-identifier="{{ choose.identifier }}" {{/if}}aria-label="{{ choose.label }}">
                     <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>{{ choose.text }}
                  </button>
                  {{/if}}
               </span>
               {{#if sub}}
               <span class="fhcs-origin-line fhcs-origin-sub" data-uuid="{{ sub.uuid }}">
                  <button type="button" class="fhcs-origin-name fhcs-body fhcs-muted" data-action="showDocument" aria-label="{{ sub.openLabel }}">{{ sub.name }}</button>
                  {{#if sub.clear}}<button type="button" class="fhcs-toggle fhcs-origin-clear" data-action="deleteDocument" data-uuid="{{ sub.clear.uuid }}" aria-label="{{ sub.clear.label }}" data-fhcs-tip="{{ sub.clear.label }}"><svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>{{/if}}
               </span>
               {{/if}}
            </span>
         </div>
         {{/each}}
      </div>
   </div>
   {{/with}}
</header>
