{{!-- One Biography text box (personality, ideals, bonds, flaws, appearance), included by biography.hbs with
      `editable`: dnd5e's textarea under dnd5e's name for whoever may edit, its paragraphs for a viewer. --}}
<section class="fhcs-bio-box" data-fhcs-box="{{ key }}">
   {{#if editable}}
   <label class="fhcs-bio-label">
      <span class="fhcs-label">{{ label }}</span>
      <textarea class="fhcs-input fhcs-body fhcs-bio-field fhcs-bio-input" name="{{ name }}" rows="2">{{ value }}</textarea>
   </label>
   {{else}}
   <h3 class="fhcs-label">{{ label }}</h3>
   {{#each paragraphs}}<p class="fhcs-body">{{ this }}</p>{{/each}}
   {{/if}}
</section>
