{{!-- The encounter sheet's header (SCOPE §4.13, the encounter sheet, user 2026-11-10): the portrait, then the name with
      the encounter's chips (dnd5e's rollQuantities, placeMembers, award) and one line: creatures, XP, difficulty. --}}
{{#with fhcsEncounter}}
<header class="fhcs-header fhcs-plate fhcs-group-header fhcs-encounter-header">
   <div class="fhcs-group-portrait fhcs-frame">
      <img class="fhcs-portrait-art" src="{{ img }}" alt="{{ name }}"
           {{#if editing}}data-action="editImage" data-edit="img"{{else}}data-action="showArtwork"{{/if}}>
   </div>
   <div class="fhcs-header-top">
      <div class="fhcs-header-row">
         {{#if editing}}
         <input type="text" class="fhcs-input fhcs-display fhcs-name fhcs-name-input" name="name" value="{{ nameSource }}" aria-label="{{ text.name }}">
         {{else}}
         <span class="fhcs-display fhcs-name" data-fhcs-tip="{{ name }}" data-fhcs-tip-cut>{{ name }}</span>
         {{/if}}
         <div class="fhcs-status fhcs-frame">
            <button type="button" class="fhcs-chip" data-action="rollQuantities" aria-label="{{ text.roll }}" data-fhcs-tip="{{ text.roll }}">
               <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l9 5v10l-9 5-9-5V7zM12 2v20M3 7l9 5 9-5"/></svg>
            </button>
            <button type="button" class="fhcs-chip always-interactive" data-action="placeMembers" aria-label="{{ text.place }}" data-fhcs-tip="{{ text.place }}">
               <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
            </button>
            <button type="button" class="fhcs-chip" data-action="award" aria-label="{{ text.award }}" data-fhcs-tip="{{ text.award }}">
               <svg class="fhcs-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4h8v5a4 4 0 0 1-8 0zM8 6H5a3 3 0 0 0 3 4M16 6h3a3 3 0 0 1-3 4M12 13v4M8 21h8M10 17h4"/></svg>
            </button>
         </div>
      </div>
      <div class="fhcs-header-row">
         <span class="fhcs-body fhcs-muted fhcs-line">{{ summary }}</span>
      </div>
   </div>
</header>
{{/with}}
